# ─────────────────────────────────────────────────────────────────────────────
# Time Tracker — environment variables
# Copy this to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# ── Sessions ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Domain (used by Caddy for TLS certificate provisioning) ───────────────────
# Set to your domain for production. Caddy automatically gets a Let's Encrypt cert.
# For local Docker testing you can leave this as localhost (uses a self-signed cert).
DOMAIN=yourdomain.com

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ── GitHub Container Registry ────────────────────────────────────────────────
# Your GitHub username (lowercase). Used to pull pre-built images from GHCR.
GITHUB_USERNAME=your-github-username

# ── Access control (optional) ─────────────────────────────────────────────────
# Restrict login to a single Google account. Leave unset to allow any Google user.
# ALLOWED_EMAIL=you@gmail.com

# ── Push notifications ─────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Leave unset to disable push notifications (opt-in toggle just won't work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Same public key, exposed to the frontend build (must be identical to VAPID_PUBLIC_KEY above).
VITE_VAPID_PUBLIC_KEY=

# ── Local development overrides ───────────────────────────────────────────────
# Uncomment these when running `npm run dev` instead of Docker:
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# FRONTEND_URL=http://localhost:5173
# DOMAIN=localhost
